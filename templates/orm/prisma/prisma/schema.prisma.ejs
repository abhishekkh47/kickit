generator client {
  provider = "prisma-client-js"
}

datasource db {
<% if (database === 'postgres') { %>
  provider = "postgresql"
<% } else if (database === 'mysql') { %>
  provider = "mysql"
<% } else { %>
  provider = "sqlite"
<% } %>
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
