import { Sequelize } from 'sequelize';
<% if (structure === 'enterprise') { %>
import { env } from './index';
import { logger } from '../utils/logger';
<% } %>

const dbUrl = <% if (structure === 'enterprise') { %> env.DATABASE_URL <% } else { %> process.env.DATABASE_URL <% } %>;

const sequelize = new Sequelize(dbUrl as string, {
  dialect: '<%= database === "postgres" ? "postgres" : (database === "mysql" ? "mysql" : "sqlite") %>',
  logging: false, // Set to true to see SQL queries
});

export const connectDB = async () => {
  try {
    await sequelize.authenticate();
<% if (structure === 'enterprise') { %>
    logger.info('Database connected successfully via Sequelize.');
<% } else { %>
    console.log('Database connected successfully via Sequelize.');
<% } %>
    // In production, migrations should be run explicitly instead of sync
    await sequelize.sync(); 
  } catch (error) {
<% if (structure === 'enterprise') { %>
    logger.error('Unable to connect to the database:', error);
<% } else { %>
    console.error('Unable to connect to the database:', error);
<% } %>
    process.exit(1);
  }
};

export default sequelize;
