<% if (framework === 'express') { %>
import { Request, Response, NextFunction } from 'express';
<% } else { %>
import { Context } from 'koa';
<% } %>

<% if (architecture === 'class') { %>
import { BaseController } from '../BaseController';
import { AuthService } from '../../services/auth/authService';

export class AuthController extends BaseController {
  private authService: AuthService;

  constructor() {
    super();
    this.authService = new AuthService();
  }

<% if (framework === 'express') { %>
  public register = async (req: Request, res: Response, next: NextFunction): Promise<void> => {
    try {
      const result = await this.authService.register(req.body);
      this.successResponse(res, result, 201, 'User registered successfully');
    } catch (error) {
      next(error);
    }
  };

  public login = async (req: Request, res: Response, next: NextFunction): Promise<void> => {
    try {
      const result = await this.authService.login(req.body);
      this.successResponse(res, result, 200, 'Login successful');
    } catch (error) {
      next(error);
    }
  };
<% } else { %>
  public register = async (ctx: Context): Promise<void> => {
    const result = await this.authService.register(ctx.request.body);
    this.successResponse(ctx, result, 201, 'User registered successfully');
  };

  public login = async (ctx: Context): Promise<void> => {
    const result = await this.authService.login(ctx.request.body);
    this.successResponse(ctx, result, 200, 'Login successful');
  };
<% } %>
}
<% } else { %>
import { successResponse } from '../BaseController';
import * as authService from '../../services/auth/authService';

<% if (framework === 'express') { %>
export const register = async (req: Request, res: Response, next: NextFunction): Promise<void> => {
  try {
    const result = await authService.register(req.body);
    successResponse(res, result, 201, 'User registered successfully');
  } catch (error) {
    next(error);
  }
};

export const login = async (req: Request, res: Response, next: NextFunction): Promise<void> => {
  try {
    const result = await authService.login(req.body);
    successResponse(res, result, 200, 'Login successful');
  } catch (error) {
    next(error);
  }
};
<% } else { %>
export const register = async (ctx: Context): Promise<void> => {
  const result = await authService.register(ctx.request.body);
  successResponse(ctx, result, 201, 'User registered successfully');
};

export const login = async (ctx: Context): Promise<void> => {
  const result = await authService.login(ctx.request.body);
  successResponse(ctx, result, 200, 'Login successful');
};
<% } %>
<% } %>
