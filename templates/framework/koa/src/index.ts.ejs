import Koa from 'koa';
import Router from 'koa-router';
import bodyParser from 'koa-bodyparser';
import cors from '@koa/cors';
import dotenv from 'dotenv';
import { errorHandler } from './middleware/errorHandler';
<% if (structure === 'enterprise') { %>
import helmet from 'koa-helmet';
import { apiLimiter } from './middleware/rateLimiter';
<% } %>
<% if (architecture === 'class') { %>
import { AppRouter } from './routes';
<% } else { %>
import { router as apiRouter } from './routes';
<% } %>

<% if (orm === 'mongoose' || orm === 'sequelize') { %>
import { connectDB } from './config/db';
<% } %>
<% if (redis) { %>
import { redisClient } from './config/redis';
<% } %>
<% if (structure === 'enterprise') { %>
import { env } from './config';
<% } %>

dotenv.config();

const app = new Koa();
const port = <% if (structure === 'enterprise') { %> env.PORT <% } else { %> process.env.PORT || 3000 <% } %>;

<% if (orm === 'mongoose' || orm === 'sequelize') { %>
// Connect to database
connectDB();
<% } %>

<% if (redis) { %>
// Connect to Redis
redisClient.connect().then(() => {
  console.log('Redis connected successfully');
}).catch((err) => {
  console.error('Redis connection failed:', err);
});
<% } %>

app.use(cors());
app.use(bodyParser());
<% if (structure === 'enterprise') { %>
// Basic Security Headers
app.use(helmet());

// Apply the rate limiting middleware to all requests
app.use(apiLimiter);

/* 
 * ========================================================
 * ADVANCED SECURITY CONFIGURATION (OPTIONAL)
 * ========================================================
 * 
 * 1. Deep XSS Sanitization
 *    npm install xss-clean
 *    // Koa requires a wrapper or custom middleware for xss-clean
 *    // Alternatively, use koa-xss-sanitizer
 *    npm install koa-xss-sanitizer
 *    import { xss } from 'koa-xss-sanitizer';
 *    app.use(xss());
 * 
 * 2. CSRF Protection
 *    npm install koa-csrf
 *    import CSRF from 'koa-csrf';
 *    app.use(new CSRF({
 *      invalidTokenMessage: 'Invalid CSRF token',
 *      invalidTokenStatusCode: 403,
 *      excludedMethods: [ 'GET', 'HEAD', 'OPTIONS' ],
 *      disableQuery: false
 *    }));
 * ========================================================
 */
<% } %>

// Global Error Handler
app.use(errorHandler);

const rootRouter = new Router();
rootRouter.get('/health', (ctx) => {
  ctx.status = 200;
  ctx.body = { status: 'ok', timestamp: new Date().toISOString() };
});
app.use(rootRouter.routes());

<% if (architecture === 'class') { %>
const appRouter = new AppRouter();
app.use(appRouter.getRouter().routes());
<% } else { %>
app.use(apiRouter.routes());
<% } %>

if (process.env.NODE_ENV !== 'test') {
  app.listen(port, () => {
    console.log(`Koa server running on http://localhost:${port}`);
  });
}

export default app;
