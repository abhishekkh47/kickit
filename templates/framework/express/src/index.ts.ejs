import express from 'express';
import cors from 'cors';
import dotenv from 'dotenv';
import { errorHandler } from './middleware/errorHandler';
<% if (structure === 'enterprise') { %>
import helmet from 'helmet';
import { apiLimiter } from './middleware/rateLimiter';
<% } %>
<% if (architecture === 'class') { %>
import { AppRouter } from './routes';
<% } else { %>
import routes from './routes';
<% } %>

<% if (orm === 'mongoose' || orm === 'sequelize') { %>
import { connectDB } from './config/db';
<% } %>
<% if (redis) { %>
import { redisClient } from './config/redis';
<% } %>
<% if (structure === 'enterprise') { %>
import { env } from './config';
<% } %>

dotenv.config();

const app = express();
const port = <% if (structure === 'enterprise') { %> env.PORT <% } else { %> process.env.PORT || 3000 <% } %>;

<% if (orm === 'mongoose' || orm === 'sequelize') { %>
// Connect to database
connectDB();
<% } %>

<% if (redis) { %>
// Connect to Redis
redisClient.connect().then(() => {
  console.log('Redis connected successfully');
}).catch((err) => {
  console.error('Redis connection failed:', err);
});
<% } %>

app.use(cors());
app.use(express.json());
<% if (structure === 'enterprise') { %>
// Basic Security Headers
app.use(helmet());

// Apply the rate limiting middleware to all requests
app.use(apiLimiter);

/* 
 * ========================================================
 * ADVANCED SECURITY CONFIGURATION (OPTIONAL)
 * ========================================================
 * 
 * 1. Deep XSS Sanitization
 *    npm install xss-clean
 *    import xss from 'xss-clean';
 *    app.use(xss());
 * 
 * 2. CSRF Protection
 *    npm install csrf-sync
 *    import { csrfSync } from 'csrf-sync';
 *    const { csrfSynchronisedProtection } = csrfSync({
 *      getTokenFromRequest: (req) => req.headers['x-csrf-token'],
 *    });
 *    app.use(csrfSynchronisedProtection);
 * ========================================================
 */
<% } %>

// Basic health check
app.get('/health', (req, res) => {
  res.status(200).json({ status: 'ok', timestamp: new Date().toISOString() });
});

<% if (architecture === 'class') { %>
// Initialize routes
const router = new AppRouter();
app.use('/api', router.getRouter());
<% } else { %>
// Initialize routes
app.use('/api', routes);
<% } %>

// Global Error Handler
app.use(errorHandler);

if (process.env.NODE_ENV !== 'test') {
  app.listen(port, () => {
    console.log(`Server running on http://localhost:${port}`);
  });
}

export default app;
