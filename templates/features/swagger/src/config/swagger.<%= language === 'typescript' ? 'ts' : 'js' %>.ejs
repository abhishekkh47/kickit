<% if (language === 'typescript') { %>
import swaggerJsDoc from 'swagger-jsdoc';

const options: swaggerJsDoc.Options = {
  definition: {
    openapi: '3.0.0',
    info: {
      title: '<%= projectName %> API Documentation',
      version: '1.0.0',
      description: 'API documentation generated by node-firestart',
    },
    servers: [
      {
        url: 'http://localhost:3000',
        description: 'Development server',
      },
    ],
    <% if (authentication === 'jwt') { %>
    components: {
      securitySchemes: {
        bearerAuth: {
          type: 'http',
          scheme: 'bearer',
          bearerFormat: 'JWT',
        },
      },
    },
    security: [
      {
        bearerAuth: [],
      },
    ],
    <% } %>
  },
  apis: ['./src/routes/*.ts', './src/controllers/*.ts'], 
};

export const swaggerSpec = swaggerJsDoc(options);
<% } else { %>
const swaggerJsDoc = require('swagger-jsdoc');

const options = {
  definition: {
    openapi: '3.0.0',
    info: {
      title: '<%= projectName %> API Documentation',
      version: '1.0.0',
      description: 'API documentation generated by node-firestart',
    },
    servers: [
      {
        url: 'http://localhost:3000',
        description: 'Development server',
      },
    ],
    <% if (authentication === 'jwt') { %>
    components: {
      securitySchemes: {
        bearerAuth: {
          type: 'http',
          scheme: 'bearer',
          bearerFormat: 'JWT',
        },
      },
    },
    security: [
      {
        bearerAuth: [],
      },
    ],
    <% } %>
  },
  apis: ['./src/routes/*.js', './src/controllers/*.js'], 
};

module.exports.swaggerSpec = swaggerJsDoc(options);
<% } %>
