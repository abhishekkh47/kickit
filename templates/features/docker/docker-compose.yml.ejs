version: '3.8'

services:
  app:
    build:
      context: .
      target: builder
    ports:
      - "<%= port %>:<%= port %>"
    environment:
      - NODE_ENV=development
      <% if (database === 'postgres') { %>
      - DB_HOST=postgres
      - DB_PORT=5432
      - DB_USER=postgres
      - DB_PASSWORD=postgres
      - DB_NAME=<%= projectName %>_db
      <% } else if (database === 'mysql') { %>
      - DB_HOST=mysql
      - DB_PORT=3306
      - DB_USER=root
      - DB_PASSWORD=root
      - DB_NAME=<%= projectName %>_db
      <% } else if (database === 'mongodb') { %>
      - DB_URI=mongodb://mongo:27017/<%= projectName %>_db
      <% } %>
      <% if (redis) { %>
      - REDIS_URL=redis://redis:6379
      <% } %>
    volumes:
      - .:/app
      - /app/node_modules
    <% if (database !== 'none' || redis) { %>
    depends_on:
      <% if (database === 'postgres') { %>
      - postgres
      <% } else if (database === 'mysql') { %>
      - mysql
      <% } else if (database === 'mongodb') { %>
      - mongo
      <% } %>
      <% if (redis) { %>
      - redis
      <% } %>
    <% } %>

  <% if (database === 'postgres') { %>
  postgres:
    image: postgres:15-alpine
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: <%= projectName %>_db
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
  <% } else if (database === 'mysql') { %>
  mysql:
    image: mysql:8
    environment:
      MYSQL_ROOT_PASSWORD: root
      MYSQL_DATABASE: <%= projectName %>_db
    ports:
      - "3306:3306"
    volumes:
      - mysql_data:/var/lib/mysql
  <% } else if (database === 'mongodb') { %>
  mongo:
    image: mongo:6-jammy
    ports:
      - "27017:27017"
    volumes:
      - mongo_data:/data/db
  <% } %>

  <% if (redis) { %>
  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
  <% } %>

<% if (database !== 'none' || redis) { %>
volumes:
  <% if (database === 'postgres') { %>
  postgres_data:
  <% } else if (database === 'mysql') { %>
  mysql_data:
  <% } else if (database === 'mongodb') { %>
  mongo_data:
  <% } %>
  <% if (redis) { %>
  redis_data:
  <% } %>
<% } %>
